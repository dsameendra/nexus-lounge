DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

NEXT_PUBLIC_SERVER_WS_URL=ws://localhost:4000/ws
PORT=4000
# Optional: file the server saves rooms to (on shutdown and every 30 s) and restores them from at boot, so a restart
# keeps them. Use a persistent volume in production; the file holds password hashes, keep it private. Empty = off.
ROOMS_SNAPSHOT_PATH=

# Optional admin overview (leave empty unless you run /admin). Set on both web and server.
# ADMIN_SECRET must be 32+ random characters and different from AUTH_SECRET.
ADMIN_SECRET=
ADMIN_DISCORD_IDS=
# Web only: base32 key for your authenticator app.
ADMIN_TOTP_SECRET=
